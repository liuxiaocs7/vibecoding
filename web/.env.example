# Optional Gemini fallback used by the Go server (not the Vite app).
# Prefer configuring OpenAI-compatible Base URL + API Key in the UI;
# those secrets are stored under ~/.vibecoding/ on the local machine.
GEMINI_API_KEY=

# Vite proxies /api to the Go backend during `npm run dev`.
# Start the backend with: make backend && ./vibecoding
